{
  "type": "mcp-server",
  "version": "0.1.0",
  "title": "CorelDRAW",
  "description": "CorelDRAW automation over MCP (stdio). Needs CorelDRAW running in the runner's desktop session; the runner provides Python 3.12 and requirements.lock's packages.",
  "manifest": {
    "mcpServers": {
      "corel": {
        "type": "stdio",
        "command": "python",
        "args": ["-B", "{plugin}/server/server.py", "--stdio"]
      }
    }
  },
  "dependsOn": [
    { "inline": { "type": "runtime", "name": "python", "version": ">=3.12,<3.13" } },
    {
      "inline": {
        "type": "packages",
        "name": "coreldraw-mcp",
        "spec": { "manager": "pip", "lockFile": "requirements.lock" }
      }
    }
  ],
  "requires": ["corel", "os:windows"]
}
