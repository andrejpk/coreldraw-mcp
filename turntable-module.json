{
  "type": "mcp-server",
  "version": "0.1.0",
  "title": "CorelDRAW",
  "description": "CorelDRAW automation over MCP (stdio). Needs CorelDRAW running in the runner's desktop session and Ghostscript installed (from ghostscript.com or winget; found as render_plates finds it and checked, never installed); the runner provides Python 3.12 and requirements.lock's packages.",
  "manifest": {
    "mcpServers": {
      "corel": {
        "type": "stdio",
        "command": "python",
        "args": ["-B", "{plugin}/server/server.py", "--stdio", "--require-ghostscript"]
      }
    }
  },
  "dependsOn": [
    { "inline": { "type": "runtime", "name": "python", "version": ">=3.12,<3.13" } },
    {
      "inline": {
        "type": "packages",
        "name": "coreldraw-mcp",
        "spec": { "manager": "pip", "lockFile": "requirements.lock" }
      }
    },
    {
      "inline": {
        "type": "system-package",
        "name": "ghostscript",
        "spec": {
          "manager": "detect",
          "detect": {
            "env": "GHOSTSCRIPT_EXE",
            "commands": ["gswin64c", "gs"],
            "paths": ["${ProgramFiles}/gs/gs*/bin/gswin64c.exe"],
            "versionArgs": ["--version"]
          },
          "packages": { "winget": "ArtifexSoftware.GhostScript" }
        }
      }
    }
  ],
  "requires": ["corel", "os:windows"]
}
